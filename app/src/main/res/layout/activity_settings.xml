<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="设置"
            android:textColor="@color/textMain"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:background="#EEEEEE"/>

        <!-- 必要权限 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="必要权限"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/status_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="17sp"/>

        <Button
            android:id="@+id/btn_open_notification_access"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="去开启「通知使用权」"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/status_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="17sp"/>

        <Button
            android:id="@+id/btn_open_accessibility"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="去开启「无障碍服务」"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <LinearLayout
            android:id="@+id/row_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textSize="17sp"/>

            <Button
                android:id="@+id/btn_open_overlay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="去开启「显示在其他应用上层」"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_fullscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textSize="17sp"/>

            <Button
                android:id="@+id/btn_open_fullscreen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="去开启「锁屏全屏通知」"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp"
            android:background="#EEEEEE"/>

        <!-- 来电提醒方式：屏幕指引 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="来电提醒方式"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <Switch
                android:id="@+id/sw_guide_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:text="来电时在屏幕上圈出绿色接听按钮（告诉老人点哪里）"
                android:textColor="@color/textMain"
                android:textSize="18sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="圈出来的位置正好套在微信那个绿色接听键上，点下去等同于点微信的按钮。圆圈不会挡住操作，另外屏幕顶部还有一个「停止提醒」按钮，随时能关掉声音。需要「显示在其他应用上层」权限。"
            android:textColor="@color/textSub"
            android:textSize="15sp"/>

        <!-- 试听 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="试听效果"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_test_voice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="▶ 试听：语音播报 + 屏幕指引（模拟张三来电）"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <!-- 语音播报状态：常驻自检，避免「误报没装 TTS」 -->
        <TextView
            android:id="@+id/status_tts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textSize="17sp"/>

        <Button
            android:id="@+id/btn_recheck_tts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:text="↻ 重新检测语音播报"
            android:textColor="@color/textMain"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btn_open_tts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:text="去设置「语音引擎 / 中文语音包」"
            android:textColor="@color/textMain"
            android:textSize="18sp"/>

        <!-- 媒体音量 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="媒体音量"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_volume_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/textSub"
            android:textSize="18sp"/>

        <SeekBar
            android:id="@+id/seek_volume"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="语音播报走的是媒体音量，建议调大一些。"
            android:textColor="@color/textSub"
            android:textSize="15sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp"
            android:background="#EEEEEE"/>

        <!-- 自动接听 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="自动接听"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <Switch
                android:id="@+id/sw_auto_master"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:text="开启自动接听（仅对标记自动接听的家人生效）"
                android:textColor="@color/textMain"
                android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动接听前等"
                android:textColor="@color/textMain"
                android:textSize="17sp"/>

            <EditText
                android:id="@+id/input_auto_delay"
                android:layout_width="80dp"
                android:layout_height="52dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:gravity="center"
                android:inputType="number"
                android:text="8"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="秒"
                android:textColor="@color/textMain"
                android:textSize="17sp"/>

            <Button
                android:id="@+id/btn_save_delay"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_btn_ghost"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="保存秒数"
                android:textColor="@color/textMain"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp"
            android:background="#EEEEEE"/>

        <!-- 后台运行 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="保持后台运行"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_open_battery"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:text="去设置「自启动 / 后台运行」（防杀后台）"
            android:textColor="@color/textMain"
            android:textSize="18sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp"
            android:background="#EEEEEE"/>

        <!-- 排查问题：来电没接上时，先看运行记录 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="接不到电话时看这里"
            android:textColor="@color/textMain"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/status_auto_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:textSize="17sp"/>

        <!-- 最近几次"微信有来电、但名单里没有他"的人：直接告诉用户该往哪填 -->
        <TextView
            android:id="@+id/tv_unmatched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFF4E5"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textSize="16sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_open_script"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="✏ 播报文字设置（改成老人听得懂的话）"
            android:textColor="#FFFFFF"
            android:textSize="19sp"/>

        <Button
            android:id="@+id/btn_open_diag"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="📋 查看运行记录（排查没自动接听）"
            android:textColor="#FFFFFF"
            android:textSize="19sp"/>

        <TextView
            android:id="@+id/tv_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="亲情接听助手 · 仅在本地运行，不联网、不上传数据"
            android:textColor="#BBBBBB"
            android:textSize="14sp"/>
    </LinearLayout>
</ScrollView>
