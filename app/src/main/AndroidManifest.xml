<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jia.callhelper"
    android:versionCode="2"
    android:versionName="1.1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>

    <!-- 弹出自己的全屏来电通知（锁屏时点亮屏幕） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- 安卓 10+ 后台弹出大按钮界面所需 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- 安卓 11+ 包可见性：只声明微信 -->
    <queries>
        <package android:name="com.tencent.mm"/>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <!-- 首页（启动器入口）：只展示家人联系人 -->
        <activity android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 设置页：从首页「⚙ 设置」进入 -->
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- 添加家人 -->
        <activity android:name=".AddContactActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- 家人详情 / 编辑 / 删除 -->
        <activity android:name=".ContactDetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- 全屏大按钮来电界面：锁屏之上显示、亮屏、常亮 -->
        <activity android:name=".CallAlertActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AlertTheme"/>

        <!-- 通知监听：读取微信来电通知（需用户在系统设置里授权） -->
        <service android:name=".WeChatCallListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- 无障碍服务：在微信通话界面里自动点「接听/挂断」（需用户在系统设置里授权） -->
        <service android:name=".CallHelperAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
    </application>
</manifest>
